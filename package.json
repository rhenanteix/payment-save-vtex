{
  "name": "paysave-vtex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "presentation": "npx serve dist/presentation",
    "landing": "npx serve landing",
    "docs:docusaurus": "npm --prefix website run start",
    "docs:docusaurus:build": "npm --prefix website run build",
    "docs:dev": "cd docs && mint dev --no-open --port 3000",
    "docs:validate": "cd docs && mint validate",
    "docs:links": "cd docs && mint broken-links"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "jsdom": "^24.0.0"
  }
}
